{
  "manifest_version": 3,
  "name": "Personal LinkedIn AI Assistant",
  "version": "1.0.0",
  "description": "AI-powered personal commenting assistant for LinkedIn, tailored to your professional profile and behavior preferences.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "shared/config.js",
        "linkedin/selectors.js",
        "linkedin/postExtractor.js",
        "linkedin/profileExtractor.js",
        "linkedin/commentInserter.js",
        "linkedin/detector.js",
        "linkedin/messageSelectors.js",
        "linkedin/messageExtractor.js",
        "linkedin/messageDetector.js",
        "ui/toolbarHelpers.js",
        "ai/api.js",
        "content.js",
        "messaging.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
